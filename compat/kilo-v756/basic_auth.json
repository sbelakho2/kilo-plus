{
  "env_var": "FAKTOR_SERVER_PASSWORD",
  "secret_format": "64 hex chars, generated by the frontend, passed to the daemon via env; the daemon never prints it",
  "username": "kilo",
  "basic_scheme": "Basic",
  "header_format": "Authorization: Basic base64(\"kilo:\" + FAKTOR_SERVER_PASSWORD)",
  "split_rule": "decode the base64 payload, split at the FIRST colon; the username must be exactly \"kilo\"; the rest is the password (constant-time compared)",
  "example_password": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
  "example_header": "Authorization: Basic a2lsbzowMTIzNDU2Nzg5YWJjZGVmMDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWYwMTIzNDU2Nzg5YWJjZGVm",
  "max_header_bytes": 4096,
  "legacy_accepted_header_forms": ["authorization_bearer", "x_faktor_server_password"],
  "required_everywhere": true,
  "required_on": ["/global/health", "all /session routes"],
  "unauthorized": {
    "code": "unauthorized",
    "http_status": 401,
    "retryable": false
  }
}
