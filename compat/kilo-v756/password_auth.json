{
  "env_var": "KILO_SERVER_PASSWORD",
  "secret_format": "64 hex chars, generated by the frontend, passed to the daemon via env; the daemon never prints it",
  "authorization_bearer": "Authorization: Bearer <password>",
  "x_kilo_server_password": "x-kilo-server-password: <password>",
  "accepted_header_forms": ["authorization_bearer", "x_kilo_server_password"],
  "public_endpoints": ["/global/health"],
  "unauthorized": {
    "code": "unauthorized",
    "http_status": 401,
    "retryable": false
  }
}
