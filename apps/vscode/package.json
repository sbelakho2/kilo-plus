{
  "name": "kilop-plus",
  "displayName": "Kilo+",
  "description": "Kilo+ daemon client (frozen v7.5.6 wire surface). Launches the kilop-cli daemon and speaks the frozen protocol.",
  "version": "0.1.0",
  "publisher": "kilop",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:kilop-plus.startServer",
    "onCommand:kilop-plus.stopServer"
  ],
  "main": "out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kilop-plus.startServer",
        "title": "Kilo+: Start Server"
      },
      {
        "command": "kilop-plus.stopServer",
        "title": "Kilo+: Stop Server"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p ."
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/vscode": "^1.90.0",
    "@types/node": "^20.0.0"
  }
}
