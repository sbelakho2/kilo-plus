{
  "name": "faktor",
  "displayName": "Faktor",
  "description": "Faktor daemon client (frozen v7.5.6 wire surface). Launches the faktor-cli daemon and speaks the frozen protocol.",
  "version": "0.1.0",
  "publisher": "faktor",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:faktor.startServer",
    "onCommand:faktor.stopServer"
  ],
  "main": "out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "faktor.startServer",
        "title": "Faktor: Start Server"
      },
      {
        "command": "faktor.stopServer",
        "title": "Faktor: Stop Server"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p ."
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/vscode": "^1.90.0",
    "@types/node": "^20.0.0"
  }
}
