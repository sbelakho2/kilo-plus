# Packaging hygiene: the VSIX ships only what the extension runtime needs.
# Built JavaScript lives in out/ (see npm run build); sources are excluded.
src/**
harness/**
scripts/**
tsconfig.json
**/*.ts
**/*.js.map
node_modules/**
.vscodeignore
# The pinned vendored webview closure is staged at media/kilo-v756-webview by
# `npm run prepackage:vsix`. Everything under media/ ships; this explicit
# re-include survives any future widening of the ignore list above.
!media/kilo-v756-webview/**
